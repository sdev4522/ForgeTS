{
  "name": "forge-ts",
  "version": "0.8.0",
  "description": "A batteries-included, TypeScript-first web framework — Laravel DX for the JS ecosystem, built for speed.",
  "type": "module",
  "scripts": {
    "serve": "tsx bin/serve.ts",
    "dev": "tsx bin/serve.ts",
    "build:client": "vite build --mode production",
    "build:ssr": "vite build --ssr --mode production",
    "build": "NODE_ENV=production npm run build:client && NODE_ENV=production npm run build:ssr",
    "start": "NODE_ENV=production tsx bin/serve.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-force-exit --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:security": "node --import tsx --test --test-force-exit tests/integration/SecurityAccessControl.test.ts",
    "forge": "tsx bin/forge.ts"
  },
  "bin": {
    "forge": "./bin/forge.ts"
  },
  "dependencies": {
    "kysely": "^0.29.4",
    "mongodb": "6.12.0",
    "mysql2": "^3.23.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "expect": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=24.7.0"
  }
}
