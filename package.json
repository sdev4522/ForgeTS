{
  "name": "forge-ts",
  "version": "0.1.0",
  "description": "A batteries-included, TypeScript-first web framework — Laravel DX for the JS ecosystem, built for speed.",
  "type": "module",
  "scripts": {
    "serve": "bun run bin/serve.ts",
    "dev": "bun --watch run bin/serve.ts",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr",
    "build": "bun run build:client && bun run build:ssr",
    "start": "NODE_ENV=production bun run bin/serve.ts",
    "test": "bun test",
    "test:security": "bun test tests/integration/SecurityAccessControl.test.ts",
    "forge": "bun run bin/forge.ts"
  },
  "bin": {
    "forge": "./bin/forge.ts"
  },
  "dependencies": {
    "kysely": "^0.29.4",
    "kysely-bun-sqlite": "^0.4.0",
    "mysql2": "^3.23.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.5.0",
    "vite": "^8.1.5"
  }
}
