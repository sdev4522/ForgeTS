APP_NAME=ForgeTS
APP_PORT=3000
APP_DEBUG=true
APP_URL=http://localhost:3000
# Interface to bind. Use 0.0.0.0 to accept connections from other machines/containers.
APP_HOST=127.0.0.1

# SQL Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forgets
DB_USERNAME=root
DB_PASSWORD=

# NoSQL Database (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=forgets

NODE_ENV=development
