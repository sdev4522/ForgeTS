{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "paths": {
      "@forge/core": ["./packages/forge/src/index.ts"],
      "@forge/database": ["./packages/forge/src/database/index.ts"],
      "@/controllers/*": ["./app/controllers/*"],
      "@/models/*": ["./app/models/*"],
      "@/services/*": ["./app/services/*"],
      "@/middleware/*": ["./app/middleware/*"],
      "@/config/*": ["./config/*"],
      "@/routes/*": ["./routes/*"],
      "@/bootstrap/*": ["./bootstrap/*"],
      "@/components/*": ["./resources/js/components/*"],
      "@/layouts/*": ["./resources/js/layouts/*"],
      "@/hooks/*": ["./resources/js/hooks/*"],
      "@/lib/*": ["./resources/js/lib/*"],
      "@/types/*": ["./resources/js/types/*"],
      "@/types": ["./resources/js/types/index.ts"],
      "@/pages/*": ["./resources/js/pages/*"],
      "@app/*": ["./app/*"],
      "@config/*": ["./config/*"],
      "@database/*": ["./database/*"],
      "@routes/*": ["./routes/*"],
      "@bootstrap/*": ["./bootstrap/*"],
      "@resources/*": ["./resources/*"],
      "@components/*": ["./resources/js/components/*"],
      "@layouts/*": ["./resources/js/layouts/*"],
      "@hooks/*": ["./resources/js/hooks/*"],
      "@lib/*": ["./resources/js/lib/*"],
      "@types/*": ["./resources/js/types/*"],
      "@types": ["./resources/js/types/index.ts"],
      "@pages/*": ["./resources/js/pages/*"],
      "@tests/*": ["./tests/*"],
      "@/*": ["./resources/js/*"]
    },
    "baseUrl": ".",
    "types": ["bun-types"]
  },
  "include": [
    "app/**/*",
    "config/**/*",
    "database/**/*",
    "routes/**/*",
    "resources/**/*",
    "bootstrap/**/*",
    "bin/**/*",
    "tests/**/*",
    "packages/**/*"
  ],
  "exclude": ["node_modules", "dist", "storage"]
}
